{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Hierarchical treemap: state/territory population subdivided by broad age group, 2021 Census.",
  "width": 900,
  "height": 500,
  "padding": 4,
  "background": "#FCF8F2",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": [
    {
      "name": "tree",
      "url": "data/c01_state_age_treemap.csv",
      "format": {
        "type": "csv",
        "parse": {
          "population": "number",
          "share_australia": "number",
          "share_state": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.node_type === 'age' ? datum.population : 0",
          "as": "treemap_value"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "treemap_value",
          "sort": {
            "field": "population",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.25,
          "size": [
            900,
            500
          ],
          "paddingInner": 2,
          "paddingOuter": 2,
          "paddingTop": 24
        }
      ]
    },
    {
      "name": "states",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "ages",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "ageColor",
      "type": "ordinal",
      "domain": [
        "0-14",
        "15-24",
        "25-44",
        "45-64",
        "65+"
      ],
      "range": [
        "#F2DDB9",
        "#E6BC8C",
        "#CA8A79",
        "#9E8698",
        "#607C89"
      ]
    },
    {
      "name": "stateColor",
      "type": "ordinal",
      "domain": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "ACT",
        "NT"
      ],
      "range": [
        "#406C96",
        "#B25B64",
        "#4B8B78",
        "#C48B48",
        "#9172A1",
        "#5C8697",
        "#AD7856",
        "#747861"
      ]
    }
  ],
  "legends": [
    {
      "fill": "ageColor",
      "title": "Age group",
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 5,
      "symbolType": "square",
      "symbolSize": 130,
      "labelFont": "Source Sans 3",
      "labelFontSize": 11,
      "titleFont": "Source Sans 3",
      "titleFontSize": 12
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "ages"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "ageColor",
            "field": "age_group"
          },
          "stroke": {
            "value": "#FBF7F0"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "tooltip": {
            "signal": "{'State / territory': datum.state, 'Age group': datum.age_group, 'Population': format(datum.population, ','), 'Share within state': format(datum.share_state, '.1f') + '%'}"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fillOpacity": {
            "value": 0.95
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "fillOpacity": {
            "value": 0
          },
          "stroke": {
            "value": "#5F5A52"
          },
          "strokeWidth": {
            "value": 2.2
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "stateColor",
            "field": "state_abbrev"
          },
          "stroke": {
            "value": "#FBF7F0"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "tooltip": {
            "signal": "{'State / territory': datum.state, 'Share of main eight (%)': format(datum.share_australia, '.1f') + '%'}"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "signal": "min(datum.y1, datum.y0+23)"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 4"
          },
          "baseline": {
            "value": "top"
          },
          "align": {
            "value": "left"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "text": {
            "signal": "datum.state_abbrev + '  ' + format(datum.share_australia, '.1f') + '%'"
          }
        },
        "update": {
          "opacity": {
            "signal": "(datum.x1-datum.x0) > 55 && (datum.y1-datum.y0) > 32 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ages"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0 + datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1)/2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "datum.age_group === '45-64' || datum.age_group === '65+' ? '#ffffff' : '#302d29'"
          },
          "text": {
            "field": "age_group"
          }
        },
        "update": {
          "opacity": {
            "signal": "(datum.x1-datum.x0) > 56 && (datum.y1-datum.y0) > 30 ? 1 : 0"
          }
        }
      }
    }
  ]
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bivariate choropleth of Bachelor degree or higher share and median weekly household income by SA2, 2021 Census.",
  "width": 820,
  "height": 560,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "scale": 850
  },
  "layer": [
    {
      "data": {
        "url": "data/c07_geometry_keys.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sa2_code": "string"
          }
        }
      },
      "transform": [
        {
          "lookup": "sa2_code",
          "from": {
            "data": {
              "url": "data/sa2_2021_vega.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "id",
            "fields": [
              "geometry"
            ]
          },
          "as": [
            "geo"
          ]
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#D9D4CC",
        "stroke": "#F7F2EA",
        "strokeWidth": 0.08
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/c07_education_income.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sa2_code": "string",
            "population": "number",
            "bachelor_plus_share": "number",
            "median_household_income_weekly": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "sa2_code",
          "from": {
            "data": {
              "url": "data/sa2_2021_vega.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "id",
            "fields": [
              "geometry"
            ]
          },
          "as": [
            "geo"
          ]
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#F7F2EA",
        "strokeWidth": 0.08
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "bivariate_class",
          "type": "nominal",
          "scale": {
            "domain": [
              "Low education / Low income",
              "Middle education / Low income",
              "High education / Low income",
              "Low education / Middle income",
              "Middle education / Middle income",
              "High education / Middle income",
              "Low education / High income",
              "Middle education / High income",
              "High education / High income"
            ],
            "range": [
              "#C7C3BC",
              "#84AEB9",
              "#3F7F90",
              "#C99191",
              "#97858D",
              "#536E79",
              "#B64B50",
              "#804047",
              "#42343B"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/state_keys.csv",
        "format": {
          "type": "csv",
          "parse": {
            "state_code": "string"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_code",
          "from": {
            "data": {
              "url": "data/states_2021_vega.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "id",
            "fields": [
              "geometry"
            ]
          },
          "as": [
            "geo"
          ]
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#625B54",
        "strokeWidth": 0.9
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/c07_education_income.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sa2_code": "string",
            "population": "number",
            "bachelor_plus_share": "number",
            "median_household_income_weekly": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "sa2_code",
          "from": {
            "data": {
              "url": "data/sa2_2021_vega.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "id",
            "fields": [
              "geometry"
            ]
          },
          "as": [
            "geo"
          ]
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#000000",
        "fillOpacity": 0.001,
        "stroke": "#000000",
        "strokeOpacity": 0
      },
      "params": [
        {
          "name": "hoverSA2",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "sa2_name",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "bachelor_plus_share",
            "type": "quantitative",
            "title": "Bachelor+ share (%)",
            "format": ".1f"
          },
          {
            "field": "median_household_income_weekly",
            "type": "quantitative",
            "title": "Median weekly household income ($)",
            "format": ",.0f"
          },
          {
            "field": "education_level",
            "type": "nominal",
            "title": "Education tertile"
          },
          {
            "field": "income_level",
            "type": "nominal",
            "title": "Income tertile"
          }
        ],
        "stroke": {
          "condition": {
            "param": "hoverSA2",
            "empty": false,
            "value": "#2F2A26"
          },
          "value": "#000000"
        },
        "strokeOpacity": {
          "condition": {
            "param": "hoverSA2",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverSA2",
            "empty": false,
            "value": 2.2
          },
          "value": 0
        }
      }
    }
  ],
  "config": {
    "background": "#FBF7F0",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  },
  "background": "#FBF7F0",
  "usermeta": {
    "图表编号": "C07",
    "图表类型": "Bivariate Choropleth（双变量分区统计图）",
    "为什么用这个图": "把education和income两个有序变量同时映射到空间，找出高-高、低-低及不一致的区域组合。",
    "主要Mark和Channel": "Area/geoshape mark；二维组合颜色=education tertile × income tertile。",
    "老师可能问": "为什么分成tertiles？",
    "回答要点": "为了让两个连续变量形成可读的3×3组合，重点是空间组合模式而不是精确数值。tooltip仍提供原始数值。",
    "配色优化": "低-低组合由接近白色改为中浅灰褐，避免与底图/无数据区域混在一起；同时叠加州界帮助定位。",
    "交互": "最上层使用几乎完全透明的SA2 geoshape作为鼠标命中层。鼠标悬停时显示tooltip，并用深色粗边框框选对应SA2；这样州/领地边界仍可放在彩色地图之上而不会阻断交互。",
    "为什么之前没有交互": "州/领地边界图层位于彩色SA2之上，会截获pointer事件。因此需要把hover交互放到一个新的最上层透明SA2图层。"
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Optimised proportional-symbol map of JobSeeker Payment recipients by 2021 SA2, June 2026.",
  "width": 820,
  "height": 560,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "scale": 850
  },
  "layer": [
    {
      "data": {
        "url": "data/c12_geometry_keys.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sa2_code": "string"
          }
        }
      },
      "transform": [
        {
          "lookup": "sa2_code",
          "from": {
            "data": {
              "url": "data/sa2_2021_vega.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "id",
            "fields": [
              "geometry"
            ]
          },
          "as": [
            "geo"
          ]
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#EEE9E1",
        "stroke": "#edf0f2",
        "strokeWidth": 0.9
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/state_keys.csv",
        "format": {
          "type": "csv",
          "parse": {
            "state_code": "string"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_code",
          "from": {
            "data": {
              "url": "data/states_2021_vega.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "id",
            "fields": [
              "geometry"
            ]
          },
          "as": [
            "geo"
          ]
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#615B55",
        "strokeWidth": 1.15
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/c12_jobseeker.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "jobseeker_payment": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.jobseeker_payment > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.38,
        "stroke": "#9f4c48",
        "strokeWidth": 0.25
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "jobseeker_payment",
          "type": "quantitative",
          "title": "JobSeeker recipients",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              2395
            ],
            "range": [
              6,
              420
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              250,
              500,
              1000,
              2000
            ],
            "titleFontSize": 12,
            "labelFontSize": 11,
            "symbolFillColor": "#C85A54",
            "symbolStrokeColor": "#9f4c48",
            "symbolOpacity": 0.5
          }
        },
        "color": {
          "value": "#C85A54"
        },
        "tooltip": [
          {
            "field": "sa2_name",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "jobseeker_payment",
            "type": "quantitative",
            "title": "JobSeeker recipients",
            "format": ","
          },
          {
            "field": "date",
            "type": "nominal",
            "title": "Period"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 135.55,
            "latitude": -13.1,
            "label": "East Arnhem  2,395"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "bottom",
        "dx": 7,
        "dy": -6,
        "color": "#7E3F3B"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FBF7F0",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "legend": {
      "padding": 8,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  },
  "background": "#FBF7F0",
  "usermeta": {
    "图表编号": "C12",
    "图表类型": "Proportional Symbol Map（比例符号地图）",
    "为什么用这个图": "DSS提供的是SA2 recipient count，因此用circle area表达count，并保留地理位置。",
    "主要Mark和Channel": "Point/circle mark；位置=SA2 representative point；circle area=size=recipient count。",
    "注意": "这是count，不是rate；代表点不是recipient实际地址。",
    "老师可能问": "为什么不用choropleth？",
    "回答要点": "这里展示absolute count。proportional symbol比用polygon填色更清楚地表达总量，也避免暗示整个区域都有同样强度。",
    "州界修复": "states_2021_vega.geojson已把properties.id复制到Feature顶层id，因此lookup key=id可以正确匹配州界。"
  }
}
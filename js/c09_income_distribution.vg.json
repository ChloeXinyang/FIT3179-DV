{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ridgeline distributions of SA2 median weekly household income by state and territory, 2021 Census.",
  "data": {
    "url": "data/c09_income_distribution.csv",
    "format": {
      "type": "csv",
      "parse": {
        "population": "number",
        "median_household_income_weekly": "number"
      }
    }
  },
  "transform": [
    {
      "density": "median_household_income_weekly",
      "groupby": [
        "state_abbrev"
      ],
      "extent": [
        500,
        4000
      ],
      "steps": 100,
      "as": [
        "income",
        "density"
      ]
    }
  ],
  "facet": {
    "row": {
      "field": "state_abbrev",
      "type": "ordinal",
      "sort": [
        "NSW",
        "VIC",
        "QLD",
        "SA",
        "WA",
        "TAS",
        "NT",
        "ACT"
      ],
      "header": {
        "title": null,
        "labelAngle": 0,
        "labelAlign": "right",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelPadding": 8
      }
    }
  },
  "spec": {
    "width": 760,
    "height": 56,
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "opacity": 0.82,
          "color": "#C07A56",
          "stroke": "#8D4E36",
          "strokeWidth": 1.1,
          "clip": true
        },
        "encoding": {
          "x": {
            "field": "income",
            "type": "quantitative",
            "title": "Median weekly household income of SA2 ($)",
            "scale": {
              "domain": [
                500,
                4000
              ]
            },
            "axis": {
              "format": "$,.0f",
              "grid": true,
              "gridColor": "#E6DED3",
              "labelFontSize": 11,
              "titleFontSize": 13
            }
          },
          "y": {
            "field": "density",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "range": [
                54,
                4
              ]
            }
          },
          "tooltip": [
            {
              "field": "income",
              "type": "quantitative",
              "title": "Weekly household income ($)",
              "format": ",.0f"
            },
            {
              "field": "density",
              "type": "quantitative",
              "title": "Density",
              "format": ".4f"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spacing": -6,
  "config": {
    "background": "#FBF7F0",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 0
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  },
  "background": "#FBF7F0",
  "usermeta": {
    "图表编号": "C09",
    "图表类型": "Ridgeline Plot（山脊图）",
    "为什么用这个图": "不仅比较州之间，还展示每个州内部SA2 median income的分布形状和跨度。",
    "主要Mark和Channel": "Area/line形状=密度分布；x=SA2 median weekly household income；facet row=state。",
    "老师可能问": "为什么不能说这是个人收入分布？",
    "回答要点": "每个observation是一个SA2的median household income，因此它是community medians的分布，不是individual incomes。"
  }
}
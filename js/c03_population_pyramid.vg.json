{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australia population pyramid, 2021 Census.",
  "width": 780,
  "height": 500,
  "data": {
    "url": "data/c03_age_sex.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 1
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "85+",
            "80-84",
            "75-79",
            "70-74",
            "65-69",
            "60-64",
            "55-59",
            "50-54",
            "45-49",
            "40-44",
            "35-39",
            "30-34",
            "25-29",
            "20-24",
            "15-19",
            "10-14",
            "5-9",
            "0-4"
          ],
          "title": "Age group",
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },
        "x": {
          "field": "plot_value",
          "type": "quantitative",
          "title": "Population",
          "scale": {
            "domain": [
              -1000000,
              1000000
            ]
          },
          "axis": {
            "values": [
              -1000000,
              -750000,
              -500000,
              -250000,
              0,
              250000,
              500000,
              750000,
              1000000
            ],
            "labelExpr": "datum.value === 0 ? '0' : format(abs(datum.value)/1000000, '.2~f') + 'm'",
            "labelFontSize": 11,
            "titleFontSize": 13
          }
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Male",
              "Female"
            ],
            "range": [
              "#315D82",
              "#D06B68"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "type": "ordinal",
            "title": "Age group"
          },
          {
            "field": "sex",
            "type": "nominal",
            "title": "Sex"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Population",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#707070",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "age_group": "30-34",
            "x": 590000,
            "label": "Largest age group"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#6B4B48"
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "85+",
            "80-84",
            "75-79",
            "70-74",
            "65-69",
            "60-64",
            "55-59",
            "50-54",
            "45-49",
            "40-44",
            "35-39",
            "30-34",
            "25-29",
            "20-24",
            "15-19",
            "10-14",
            "5-9",
            "0-4"
          ]
        },
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1000000,
              1000000
            ]
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#eeeeee",
      "domain": false,
      "tickColor": "#cccccc",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "background": "#FBF7F0",
    "font": "Source Sans 3",
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  },
  "background": "#FBF7F0",
  "usermeta": {
    "图表编号": "C03",
    "图表类型": "Population Pyramid（人口金字塔）",
    "为什么用这个图": "同时比较年龄结构和男女差异。左右镜像让两个性别在同一年龄组上直接比较。",
    "主要Mark和Channel": "Line/bar mark；长度=人口数量；位置=年龄组；Hue=sex。",
    "注意": "Male的负数只是布局用，tooltip仍显示正的人口数量。",
    "老师可能问": "为什么male要设为负值？",
    "回答要点": "只为了把male画到左侧形成镜像，不代表人口为负。"
  }
}
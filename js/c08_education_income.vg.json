{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "SA2 Bachelor degree or higher share versus median weekly household income, 2021 Census.",
  "width": 760,
  "height": 470,
  "data": {
    "url": "data/c08_education_income.csv",
    "format": {
      "type": "csv",
      "parse": {
        "population": "number",
        "bachelor_plus_share": "number",
        "median_household_income_weekly": "number",
        "median_age": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 36,
        "opacity": 0.5,
        "color": "#6F8175"
      },
      "encoding": {
        "x": {
          "field": "bachelor_plus_share",
          "type": "quantitative",
          "title": "Residents aged 15+ with Bachelor degree or higher (%)",
          "scale": {
            "domain": [
              0,
              70
            ]
          },
          "axis": {
            "labelExpr": "datum.label + '%'",
            "gridColor": "#E4DED4"
          }
        },
        "y": {
          "field": "median_household_income_weekly",
          "type": "quantitative",
          "title": "Median weekly household income ($)",
          "scale": {
            "domain": [
              500,
              4600
            ]
          },
          "axis": {
            "format": "$,.0f",
            "gridColor": "#E4DED4"
          }
        },
        "tooltip": [
          {
            "field": "sa2_name",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "bachelor_plus_share",
            "type": "quantitative",
            "title": "Bachelor+ share (%)",
            "format": ".1f"
          },
          {
            "field": "median_household_income_weekly",
            "type": "quantitative",
            "title": "Median weekly household income ($)",
            "format": ",.0f"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Population",
            "format": ","
          }
        ]
      },
      "transform": [
        {
          "filter": "statePick === 'All' || datum.state_abbrev === statePick"
        }
      ]
    },
    {
      "transform": [
        {
          "regression": "median_household_income_weekly",
          "on": "bachelor_plus_share",
          "method": "linear"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#3E3B37",
        "strokeWidth": 2.4,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "bachelor_plus_share",
          "type": "quantitative"
        },
        "y": {
          "field": "median_household_income_weekly",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "stroke": "#A89F93",
        "strokeDash": [
          5,
          5
        ],
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 21.37
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "stroke": "#A89F93",
        "strokeDash": [
          5,
          5
        ],
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "datum": 1755.0
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 4,
            "y": 4250,
            "label": "Overall relationship: r ≈ 0.68"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#4D4943"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FBF7F0",
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 13,
      "domainColor": "#CFC7BC",
      "tickColor": "#CFC7BC",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  },
  "params": [
    {
      "name": "statePick",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS",
          "NT",
          "ACT"
        ],
        "labels": [
          "All Australia",
          "NSW",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "ACT"
        ],
        "name": "Focus on state / territory: "
      }
    }
  ]
}
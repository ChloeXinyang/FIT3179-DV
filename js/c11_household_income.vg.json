{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell comparison of family and non-family household income profiles.",
  "width": 740,
  "height": 330,
  "data": {
    "url": "data/c11_household_income.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number",
        "share_valid_income": "number"
      }
    }
  },
  "transform": [
    {
      "pivot": "household_type",
      "value": "share_valid_income",
      "groupby": [
        "income_band"
      ]
    },
    {
      "calculate": "datum['Family household'] - datum['Non-family household']",
      "as": "gap"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#B8B0A6",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "income_band",
          "type": "ordinal",
          "sort": [
            "<$800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelPadding": 8,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "Family household",
          "type": "quantitative",
          "title": "Share within household type (%)",
          "scale": {
            "domain": [
              0,
              50
            ]
          },
          "axis": {
            "labelExpr": "datum.label + '%'",
            "gridColor": "#E5DED4",
            "titleFontSize": 13
          }
        },
        "x2": {
          "field": "Non-family household"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "color": "#7A5D8E"
      },
      "encoding": {
        "y": {
          "field": "income_band",
          "type": "ordinal",
          "sort": [
            "<$800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ]
        },
        "x": {
          "field": "Family household",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "income_band",
            "type": "ordinal",
            "title": "Weekly income"
          },
          {
            "field": "Family household",
            "type": "quantitative",
            "title": "Family household (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "color": "#D1A34F"
      },
      "encoding": {
        "y": {
          "field": "income_band",
          "type": "ordinal",
          "sort": [
            "<$800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ]
        },
        "x": {
          "field": "Non-family household",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "income_band",
            "type": "ordinal",
            "title": "Weekly income"
          },
          {
            "field": "Non-family household",
            "type": "quantitative",
            "title": "Non-family household (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.income_band === '<$800'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 8,
        "dy": -12,
        "align": "left",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#8B6A28"
      },
      "encoding": {
        "y": {
          "field": "income_band",
          "type": "ordinal",
          "sort": [
            "<$800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ]
        },
        "x": {
          "field": "Non-family household",
          "type": "quantitative"
        },
        "text": {
          "value": "47.1% non-family"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.income_band === '$3,500+'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 8,
        "dy": -12,
        "align": "left",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#684D78"
      },
      "encoding": {
        "y": {
          "field": "income_band",
          "type": "ordinal",
          "sort": [
            "<$800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ]
        },
        "x": {
          "field": "Family household",
          "type": "quantitative"
        },
        "text": {
          "value": "23.3% family"
        }
      }
    }
  ],
  "config": {
    "background": "#FBF7F0",
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "domainColor": "#CFC7BC",
      "tickColor": "#CFC7BC",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  },
  "usermeta": {
    "图表编号": "C11",
    "图表类型": "Dumbbell Chart（哑铃图）",
    "为什么用这个图": "每个income band只需要比较family与non-family两个数，连线长度直接突出两者差距。",
    "主要Mark和Channel": "Point marks=两个household type的share；Line/rule=gap；x position=percentage。",
    "老师可能问": "为什么比双折线更合适？",
    "回答要点": "income bands是离散区间，重点是每个区间内两个群体的差异，而不是连续趋势。"
  }
}
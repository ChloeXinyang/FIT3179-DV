{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Small-multiple radial age profiles for Australian states and territories, 2021 Census.",
  "width": 760,
  "height": 445,
  "padding": {
    "left": 20,
    "right": 20,
    "top": 12,
    "bottom": 36
  },
  "autosize": {
    "type": "none",
    "contains": "padding"
  },
  "data": [
    {
      "name": "profiles",
      "url": "data/c04_radial_age_profiles.csv",
      "format": {
        "type": "csv",
        "parse": {
          "count": "number",
          "share_of_state_population": "number",
          "cx": "number",
          "cy": "number",
          "start_angle": "number",
          "end_angle": "number",
          "outer_radius": "number"
        }
      }
    },
    {
      "name": "states",
      "url": "data/c04_radial_state_labels.csv",
      "format": {
        "type": "csv",
        "parse": {
          "cx": "number",
          "cy": "number"
        }
      }
    },
    {
      "name": "legend",
      "url": "data/c04_radial_legend.csv",
      "format": {
        "type": "csv",
        "parse": {
          "x": "number"
        }
      }
    }
  ],
  "marks": [
    {
      "type": "arc",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "cx"
          },
          "y": {
            "field": "cy"
          },
          "startAngle": {
            "value": 0
          },
          "endAngle": {
            "value": 6.283185307179586
          },
          "innerRadius": {
            "value": 34.57142857142857
          },
          "outerRadius": {
            "value": 35.17142857142857
          },
          "fill": {
            "value": "#D8CFC4"
          },
          "fillOpacity": {
            "value": 0.75
          }
        }
      }
    },
    {
      "type": "arc",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "cx"
          },
          "y": {
            "field": "cy"
          },
          "startAngle": {
            "value": 0
          },
          "endAngle": {
            "value": 6.283185307179586
          },
          "innerRadius": {
            "value": 51.14285714285714
          },
          "outerRadius": {
            "value": 51.74285714285714
          },
          "fill": {
            "value": "#D8CFC4"
          },
          "fillOpacity": {
            "value": 0.75
          }
        }
      }
    },
    {
      "type": "arc",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "cx"
          },
          "y": {
            "field": "cy"
          },
          "startAngle": {
            "value": 0
          },
          "endAngle": {
            "value": 6.283185307179586
          },
          "innerRadius": {
            "value": 67.71428571428571
          },
          "outerRadius": {
            "value": 68.3142857142857
          },
          "fill": {
            "value": "#D8CFC4"
          },
          "fillOpacity": {
            "value": 0.75
          }
        }
      }
    },
    {
      "type": "arc",
      "from": {
        "data": "profiles"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "cx"
          },
          "y": {
            "field": "cy"
          },
          "startAngle": {
            "field": "start_angle"
          },
          "endAngle": {
            "field": "end_angle"
          },
          "innerRadius": {
            "value": 18
          },
          "outerRadius": {
            "field": "outer_radius"
          },
          "fill": {
            "field": "color"
          },
          "stroke": {
            "value": "#FBF7F0"
          },
          "strokeWidth": {
            "value": 1.3
          },
          "tooltip": {
            "signal": "{'State / territory': datum.state, 'Age group': datum.age_group, 'Share': format(datum.share_of_state_population, '.1f') + '%', 'Population': format(datum.count, ',')}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.72
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "cx"
          },
          "y": {
            "signal": "datum.cy - 88"
          },
          "text": {
            "field": "state_abbrev"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#3E3833"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "legend"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },
          "y": {
            "value": 424
          },
          "shape": {
            "value": "square"
          },
          "size": {
            "value": 95
          },
          "fill": {
            "field": "color"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "legend"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x + 10"
          },
          "y": {
            "value": 424
          },
          "text": {
            "field": "age_group"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#5E564F"
          }
        }
      }
    }
  ],
  "background": "#FBF7F0",
  "config": {
    "background": "#FBF7F0"
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Age-group share of each state or territory population, 2021 Census.",
  "width": 700,
  "height": 360,
  "data": {
    "url": "data/c04_state_age.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "0-14",
            "15-24",
            "25-44",
            "45-64",
            "65+"
          ],
          "title": "Age group",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "labelPadding": 7
          }
        },
        "y": {
          "field": "state_abbrev",
          "type": "nominal",
          "sort": [
            "NSW",
            "VIC",
            "QLD",
            "SA",
            "WA",
            "TAS",
            "NT",
            "ACT"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelPadding": 7,
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "share_of_state_population",
          "type": "quantitative",
          "title": "Share of state population (%)",
          "scale": {
            "scheme": "blues",
            "domain": [
              8,
              34
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 280,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "age_group",
            "type": "ordinal",
            "title": "Age group"
          },
          {
            "field": "share_of_state_population",
            "type": "quantitative",
            "title": "Share",
            "format": ".1f"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Population",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "0-14",
            "15-24",
            "25-44",
            "45-64",
            "65+"
          ]
        },
        "y": {
          "field": "state_abbrev",
          "type": "nominal",
          "sort": [
            "NSW",
            "VIC",
            "QLD",
            "SA",
            "WA",
            "TAS",
            "NT",
            "ACT"
          ]
        },
        "text": {
          "field": "share_of_state_population",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.share_of_state_population >= 24",
            "value": "white"
          },
          "value": "#263238"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domainColor": "#d6dbe3",
      "tickColor": "#d6dbe3"
    },
    "legend": {
      "padding": 8
    }
  }
}
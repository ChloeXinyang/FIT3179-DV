{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Alluvial/Sankey view linking household size to family/non-family household type, Australia 2021 Census.",
  "width": 760,
  "height": 500,
  "padding": {
    "left": 20,
    "right": 20,
    "top": 16,
    "bottom": 22
  },
  "autosize": {
    "type": "none",
    "contains": "padding"
  },
  "data": [
    {
      "name": "nodes",
      "url": "data/c10_sankey_nodes.csv",
      "format": {
        "type": "csv",
        "parse": {
          "x0": "number",
          "x1": "number",
          "y0": "number",
          "y1": "number",
          "yc": "number",
          "value": "number"
        }
      }
    },
    {
      "name": "links",
      "url": "data/c10_sankey_links.csv",
      "format": {
        "type": "csv",
        "parse": {
          "count": "number",
          "share_within_size": "number",
          "share_all": "number",
          "source_x": "number",
          "source_y": "number",
          "target_x": "number",
          "target_y": "number",
          "link_width": "number"
        }
      }
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "enter": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "field": "color"
          },
          "strokeWidth": {
            "field": "link_width"
          },
          "strokeOpacity": {
            "value": 0.45
          },
          "fill": {
            "value": null
          },
          "tooltip": {
            "signal": "{'Household size': datum.household_size, 'Household type': datum.household_type, 'Households': format(datum.count, ','), 'Share within size': format(datum.share_within_size, '.1f') + '%', 'Share of all households': format(datum.share_all, '.1f') + '%'}"
          },
          "strokeCap": {
            "value": "butt"
          }
        },
        "hover": {
          "strokeOpacity": {
            "value": 0.78
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "field": "fill"
          },
          "cornerRadius": {
            "value": 3
          },
          "tooltip": {
            "signal": "{'Group': datum.label, 'Households': format(datum.value, ','), 'Share': datum.sub_label}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.side === 'source' ? datum.x0 - 10 : datum.x1 + 10"
          },
          "y": {
            "field": "yc"
          },
          "align": {
            "signal": "datum.side === 'source' ? 'right' : 'left'"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#3E3833"
          },
          "text": {
            "field": "label"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.side === 'source' ? datum.x0 - 10 : datum.x1 + 10"
          },
          "y": {
            "signal": "datum.yc + 16"
          },
          "align": {
            "signal": "datum.side === 'source' ? 'right' : 'left'"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 10.5
          },
          "fill": {
            "value": "#71685F"
          },
          "text": {
            "field": "sub_label"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 150
          },
          "y": {
            "value": 12
          },
          "text": {
            "value": "Household size"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5E564F"
          },
          "align": {
            "value": "center"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 610
          },
          "y": {
            "value": 12
          },
          "text": {
            "value": "Household type"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5E564F"
          },
          "align": {
            "value": "center"
          }
        }
      }
    }
  ],
  "background": "#FBF7F0",
  "config": {
    "background": "#FBF7F0"
  },
  "usermeta": {
    "图表编号": "C10",
    "图表类型": "Alluvial / Sankey（桑基/冲积图）",
    "为什么改成这个图": "原Marimekko右侧5人和6+类别太窄，标签拥挤。Sankey把household size放左侧、household type放右侧，用流带宽度显示household数量，层级更清楚。",
    "主要Mark和Channel": "Rect node + curved link；source/target position=类别；link thickness=household count；Hue=family/non-family。",
    "如何读": "从左侧某个household size沿流带看向右侧即可看到其family/non-family去向；流带越宽表示households越多。",
    "老师可能问": "为什么不再用Marimekko？",
    "回答要点": "Marimekko同时编码width和height但窄类别标签难读；Sankey仍保留“size→type”关系，而且标签可以放在两侧，视觉层级更清楚。"
  }
}